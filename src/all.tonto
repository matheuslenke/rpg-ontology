package RPGOntology


kind Individual {
    label {
        @pt-br "Indivíduo"
        @en "Individual"
    }
    description {
        @pt-br "Um indivíduo que é um ser vivo ou outrora vivo e está presente no universo."
        @en "An individual who is or was once a living being and is present in the universe."
    }

    name: string
    birthDate: date { const }
    (natives) [*] -- isBornIn -- [1] ({const} birthplace) Place
    (nativeSpeakers) [*] -- hasMotherTongue -- [1] (motherTongue) Language
    (speakers) [*] -- speaks -- [0..*] (languagesSpoken) Language
    alignment: Alignment
    height: number
}

kind Language {
    label {
        @pt-br "Língua"
        @en "Language"
    }
    description {
        @pt-br "Um sistema estruturado de comunicação usado por personagens e criaturas para interagir entre si."
        @en "A structured system of communication used by characters and creatures to interact with each other."
    }

    name: string
    isAlive: boolean
    difficulty: number
    writingSystem: string
    (speakers) [*] -- hasDialect -- [0..*] (dialects) Language // hasDialect represents the dialects of the language
    (originRace) [0..*] -- originatedFrom -- [0..1] Race // originatedFrom represents where the language originated from
}

enum Alignment {
    label {
        @pt-br "Alinhamento"
        @en "Alignment"
    }
    description {
        @pt-br "Um alinhamento é um conjunto de valores que define o comportamento moral e ético de um personagem."
        @en "An alignment is a set of values that defines a character's moral and ethical behavior."
    }
    LawfulGood,
    LawfulNeutral,
    LawfulEvil,
    NeutralGood,
    TrueNeutral,
    NeutralEvil,
    ChaoticGood,
    ChaoticNeutral,
    ChaoticEvil
}

subkind Monster specializes Individual {
    label {
        @pt-br "Monstro"
        @en "Monster"
    }
    description {
        @pt-br "Um monstro é um ser, frequentemente não-humanoide ou bestial, que pode representar uma ameaça ou desafio, muitas vezes com tendências hostis ou instintivas."
        @en "A monster is a being, often non-humanoid or bestial, that may pose a threat or challenge, often with hostile or instinctual tendencies."
    }
}

subkind Character specializes Individual {
    label {
        @pt-br "Personagem"
        @en "Character"
    }
    description {
        @pt-br "Um personagem é um indivíduo com agência, personalidade e papel dentro da narrativa ou mundo do jogo, geralmente pertencente a uma raça específica."
        @en "A character is an individual with agency, personality, and a role within the narrative or game world, usually belonging to a specific race."
    }

    level: number

    [*] -- is -- [1..2] Race

    [*] -- hasInventory -- [1] Inventory
    [*] -- hasSkills -- [0..*] Skill
    @characterization [1] -- hasStrengh -- [1] Strength
    @characterization [1] -- hasIntelligence -- [1] Intelligence
    @characterization [1] -- hasAgility -- [1] Agility
    @characterization [1] -- hasVitality -- [1] Vitality
    @characterization [1] -- hasCharisma -- [1] Charisma
    @characterization [1] -- hasWisdom -- [1] Wisdom
}

subkind PlayableCharacter specializes Character {
    label {
        @pt-br "Personagem Jogável"
        @en "Playable Character"
    }
    description {
        @pt-br "Um personagem jogável (PC) é um personagem que é diretamente controlado por um jogador."
        @en "A playable character (PC) is a character that is directly controlled by a player."
    }
}
subkind NonPlayableCharacter specializes Character {
    label {
        @pt-br "Personagem Não Jogável"
        @en "Non-Playable Character"
    }
    description {
        @pt-br "Um personagem não jogável (NPC) é um personagem controlado pelo mestre do jogo ou pelo sistema, interagindo com os PCs mas não controlado por um jogador."
        @en "A non-playable character (NPC) is a character controlled by the game master or the system, interacting with the PCs but not controlled by a player."
    }
}

role Worker specializes Character {
    label {
        @pt-br "Trabalhador"
        @en "Worker"
    }
    description {
        @pt-br "Um trabalhador é um personagem definido por sua ocupação ou profissão, engajado em alguma forma de trabalho."
        @en "A worker is a character defined by their occupation or profession, engaged in some form of labor."
    }
}

phase AliveIndividual specializes Individual {
    label {
        @pt-br "Indivíduo Vivo"
        @en "Alive Individual"
    }
    description {
        @pt-br "Um indivíduo vivo é um indivíduo que está atualmente no estado de vida."
        @en "An alive individual is an individual who is currently in the state of being alive."
    }
}

phase UndeadIndividual specializes Individual {
    label {
        @pt-br "Indivíduo Morto-Vivo"
        @en "Undead Individual"
    }
    description {
        @pt-br "Um indivíduo morto-vivo é um ser que morreu mas foi reanimado por forças sobrenaturais, existindo em um estado entre a vida e a morte."
        @en "An undead individual is a being that has died but has been reanimated by supernatural forces, existing in a state between life and death."
    }
}

phase DeadIndividual specializes Individual {
    label {
        @pt-br "Indivíduo Morto"
        @en "Dead Individual"
    }
    description {
        @pt-br "Um indivíduo morto é um indivíduo que cessou suas funções vitais e não está vivo nem morto-vivo."
        @en "A dead individual is an individual who has ceased vital functions and is neither alive nor undead." 
    }
}


type Class {
    label {
        @pt-br "Classe"
        @en "Class"
    }
    description {
        @pt-br "Em jogos de RPG, uma classe é uma categoria de personagens que compartilham habilidades e características comuns. Uma classe dá habilidades (ou perícias) exclusivas para o personagem de cada classe."
        @en "In RPG games, a class is a category of characters who share common skills and characteristics. A class grants exclusive abilities (or proficiencies) to the character of that class."
    }
}

disjoint genset TypesOfClasses {
    general Character
    categorizer Class
    specifics Warrior, Mage, Rogue, Cleric, Ranger, Paladin, Druid, Barbarian, Bard, Monk, Sorcerer, Warlock, Shaman
}

subkind Warrior (instanceOf Class) specializes Character {
    label {
        @pt-br "Guerreiro"
        @en "Warrior"
    }
    description {
        @pt-br "O Guerreiro é uma classe de personagens típica de cenários de fantasia medieval, dentre os quais se destacam os jogos Dungeons & Dragons, também chamado de D&D e Pathfinder Roleplaying Game."
        @en "The Warrior is a character class typical of medieval fantasy settings, prominent in games such as Dungeons & Dragons (also called D&D) and Pathfinder Roleplaying Game."
    }
}

subkind Mage (instanceOf Class) specializes Character {
    label {
        @pt-br "Mago"
        @en "Mage"
    }
    description {
        @pt-br "O Mago é uma classe de personagem típica de cenários de fantasia, conhecida por sua maestria em magia e artes arcanas. Frequentemente utilizam sua inteligência ou sabedoria para lançar feitiços, manipular os elementos ou influenciar mentes. São proeminentes em jogos como Dungeons & Dragons (D&D) e Pathfinder Roleplaying Game."
        @en "The Mage is a character class typical of fantasy settings, known for mastery in magic and arcane arts. They often use their intelligence or wisdom to cast spells, manipulate elements, or influence minds. They are prominent in games like Dungeons & Dragons (D&D) and Pathfinder Roleplaying Game."
    }
}

subkind Rogue (instanceOf Class) specializes Character {
    label {
        @pt-br "Ladino"
        @en "Rogue"
    }
    description {
        @pt-br "O Ladino é uma classe focada em furtividade, agilidade e perícias. São mestres em se esconder nas sombras, desarmar armadilhas, abrir fechaduras e realizar ataques precisos e sorrateiros, geralmente contando com alta Destreza. Essenciais em jogos como D&D e World of Warcraft."
        @en "The Rogue is a class focused on stealth, agility, and  They are masters of hiding in shadows, disarming traps, picking locks, and performing precise, sneaky attacks, generally relying on high Dexterity. Essential in games like D&D and World of Warcraft."
    }
}

subkind Cleric (instanceOf Class) specializes Character {
    label {
        @pt-br "Clérigo"
        @en "Cleric"
    }
    description {
        @pt-br "O Clérigo é um agente de um poder divino (como um deus ou filosofia), canalizando energia sagrada. São conhecidos por curar ferimentos, proteger aliados com magia divina e punir inimigos (especialmente mortos-vivos), frequentemente utilizando Sabedoria. Uma classe fundamental em D&D e similar ao Sacerdote (Priest) em World of Warcraft."
        @en "The Cleric is an agent of a divine power (such as a god or philosophy), channeling sacred energy. They are known for healing wounds, protecting allies with divine magic, and smiting foes (especially undead), often utilizing Wisdom. A fundamental class in D&D and similar to the Priest in World of Warcraft."
    }
}

subkind Ranger (instanceOf Class) specializes Character {
    label {
        @pt-br "Ranger"
        @en "Ranger"
    }
    description {
        @pt-br "O Ranger é um combatente habilidoso adaptado à vida selvagem e fronteiriça. São peritos em rastreamento, sobrevivência e combate à distância (frequentemente com arcos), utilizando Destreza e Sabedoria. Podem ter laços com a natureza, companheiros animais ou usar magias menores. Presentes em D&D e análogos ao Caçador (Hunter) em World of Warcraft."
        @en "The Ranger is a skilled combatant adapted to wilderness and frontier life. They are experts in tracking, survival, and ranged combat (often with bows), utilizing Dexterity and Wisdom. They may have bonds with nature, animal companions, or use minor spells. Present in D&D and analogous to the Hunter in World of Warcraft."
    }
}

subkind Paladin (instanceOf Class) specializes Character {
    label {
        @pt-br "Paladino"
        @en "Paladin"
    }
    description {
        @pt-br "O Paladino é um guerreiro sagrado vinculado a um juramento ou divindade, combinando proeza marcial com poder divino. Usam armaduras pesadas, curam ferimentos, protegem aliados com auras e golpeiam inimigos com justiça sagrada, geralmente baseados em Força e Carisma. Uma classe icônica em D&D e World of Warcraft."
        @en "The Paladin is a holy warrior bound by an oath or to a deity, combining martial prowess with divine power. They wear heavy armor, heal wounds, protect allies with auras, and strike enemies with holy justice, generally based on Strength and Charisma. An iconic class in D&D and World of Warcraft."
    }
}

subkind Druid (instanceOf Class) specializes Character {
    label {
        @pt-br "Druida"
        @en "Druid"
    }
    description {
        @pt-br "O Druida é um conjurador que extrai poder da natureza selvagem, buscando proteger o equilíbrio. São conhecidos por sua capacidade de se transformar em animais (metamorfose), conjurar magias elementais e de cura, e comungar com a flora e fauna, baseando-se em Sabedoria. Classe central em D&D e World of Warcraft."
        @en "The Druid is a spellcaster who draws power from wild nature, seeking to protect balance. They are known for their ability to transform into animals (shapeshifting), cast elemental and healing spells, and commune with flora and fauna, relying on Wisdom. A central class in D&D and World of Warcraft."
    }
}

subkind Barbarian (instanceOf Class) specializes Character {
    label {
        @pt-br "Bárbaro"
        @en "Barbarian"
    }
    description {
        @pt-br "O Bárbaro é um combatente feroz movido por instinto e fúria primal, vindo de terras selvagens ou tribais. Destacam-se pela sua força bruta, resistência incrível e a capacidade de entrar em um estado de 'Fúria' (Rage) para aumentar seu poder em combate, confiando em Força e Constituição. Comuns em cenários de fantasia como D&D."
        @en "The Barbarian is a fierce combatant driven by instinct and primal fury, hailing from wild or tribal lands. They stand out for their brute strength, incredible resilience, and the ability to enter a state of 'Rage' to increase their power in combat, relying on Strength and Constitution. Common in fantasy settings like D&D."
    }
}

subkind Bard (instanceOf Class) specializes Character {
    label {
        @pt-br "Bardo"
        @en "Bard"
    }
    description {
        @pt-br "O Bardo é um mestre da música, performance, conhecimento e persuasão, usando suas habilidades artísticas para inspirar aliados, desmoralizar inimigos e tecer magias arcanas. São versáteis ('pau para toda obra'), com acesso a diversas perícias e feitiços, geralmente utilizando Carisma. Uma classe distinta em sistemas como D&D."
        @en "The Bard is a master of music, performance, knowledge, and persuasion, using artistic skills to inspire allies, demoralize enemies, and weave arcane magic. They are versatile ('jack-of-all-trades'), with access to diverse skills and spells, generally utilizing Charisma. A distinct class in systems like D&D."
    }
}

subkind Monk (instanceOf Class) specializes Character {
    label {
        @pt-br "Monge"
        @en "Monk"
    }
    description {
        @pt-br "Em jogos de RPG, o Monge é um mestre das artes marciais que aprimora corpo e mente através de disciplina rigorosa. Lutam desarmados ou com armas específicas ('armas de monge'), canalizando energia interior ('Ki' ou 'Chi') para realizar feitos incríveis de velocidade, poder e resistência defensiva, geralmente usando Destreza e Sabedoria."
        @en "In RPG games, the Monk is a master of martial arts who hones body and mind through rigorous discipline. They fight unarmed or with specific 'monk weapons', channeling inner energy ('Ki' or 'Chi') to perform incredible feats of speed, power, and defensive resilience, generally using Dexterity and Wisdom."
    }
}

subkind Sorcerer (instanceOf Class) specializes Character {
    label {
        @pt-br "Feiticeiro"
        @en "Sorcerer"
    }
    description {
        @pt-br "Em jogos de RPG, o Feiticeiro possui magia inata, derivada de uma linhagem (ex: dragão, celestial), evento sobrenatural ou dom bruto. Conjura magias arcanas espontaneamente usando sua força de vontade (geralmente Carisma), muitas vezes com grande poder bruto ou flexibilidade de conjuração ('metamagia'), embora com um repertório conhecido mais limitado que o Mago."
        @en "In RPG games, the Sorcerer possesses innate magic, derived from a bloodline (e.g., dragon, celestial), supernatural event, or raw gift. They cast arcane spells spontaneously using their force of will (usually Charisma), often with great raw power or casting flexibility ('metamagic'), albeit with a potentially more limited known repertoire than a Wizard/Mage."
    }
}

subkind Warlock (instanceOf Class) specializes Character {
    label {
        @pt-br "Bruxo"
        @en "Warlock"
    }
    description {
        @pt-br "Em jogos de RPG, o Bruxo adquire poder arcano através de um pacto com uma entidade poderosa (como um demônio, arquifada, ser antigo ou cósmico). Utilizam magias únicas concedidas por seu patrono, invocações místicas para customizar habilidades (como a 'Rajada Mística' - Eldritch Blast), e frequentemente focam em dano contínuo ou debuffs, usando Carisma."
        @en "In RPG games, the Warlock acquires arcane power through a pact with a powerful entity (such as a demon, archfey, ancient being, or cosmic entity). They use unique spells granted by their patron, mystical invocations to customize abilities (like 'Eldritch Blast'), and often focus on sustained damage or debuffs, using Charisma."
    }
}

subkind Shaman (instanceOf Class) specializes Character {
    label {
        @pt-br "Xamã"
        @en "Shaman"
    }
    description {
        @pt-br "Em jogos de RPG, o Xamã atua como um mediador entre o mundo físico e os reinos espirituais, comungando com espíritos ancestrais ou elementais. Utilizam totens, conjuram magias elementais (fogo, terra, água, ar), curam aliados e podem até mesmo aprimorar o combate corpo a corpo, servindo como uma classe híbrida versátil (comum em jogos como World of Warcraft)."
        @en "In RPG games, the Shaman acts as a mediator between the physical world and the spirit realms, communing with ancestral or elemental spirits. They utilize totems, cast elemental spells (fire, earth, water, air), heal allies, and may even enhance melee combat, serving as a versatile hybrid class (common in games like World of Warcraft)."
    }
}


enum ProfessionSkillLevel {
    label {
        @pt-br "Nível de Habilidade da Profissão"
        @en "Profession Skill Level"
    }
    description {
        @pt-br "Representa o nível de expertise ou competência em uma dada profissão."
        @en "Represents the level of expertise or competence in a given profession."
    }

    Dummy,
    Beginner,
    Intermediate,
    Advanced
}

type Profession {
    label {
        @pt-br "Profissão"
        @en "Profession"
    }
    description {
        @pt-br "É uma categoria para Personagens definida por habilidades relacionadas a uma determinada área ou ocupação."
        @en "A category for Characters defined by skills related to a specific area or occupation."
    }

    level: ProfessionSkillLevel

    [*] -- requiresSkills -- [0..*] Skill
    (professions) [*] -- [1..*] ({ ordered } mostImportantAttributes) Attribute
}

genset TypesOfProfession {
    general Character
    categorizer Profession
    specifics Blacksmith, Herbalist, Tailor, PotionBrewer, Merchant, Guard, Scholar, Farmer, Miner, Carpenter
}

phase Blacksmith (instanceOf Profession) specializes Character {
     label {
         @pt-br "Ferreiro"
         @en "Blacksmith"
     }
     description {
         @pt-br "Um artesão capaz de executar competentemente a forja e reparo de objetos de metal, como armas, armaduras e ferramentas. O indivíduo é um ferreiro enquanto possui as habilidades necessárias para executar tais tarefas."
         @en "An artisan capable of competently forging and repairing metal objects, such as weapons, armor, and tools. The individual is a blacksmith as long as they possess the necessary skills to perform such tasks."
     }
 }

phase Herbalist (instanceOf Profession) specializes Character {
     label {
         @pt-br "Herbalista"
         @en "Herbalist"
     }
     description {
         @pt-br "Um indivíduo com conhecimento em plantas e ervas, utilizando-as para fins medicinais, culinários ou outros."
         @en "An individual with knowledge of plants and herbs, using them for medicinal, culinary, or other purposes."
     }
 }

phase Tailor (instanceOf Profession) specializes Character {
     label {
         @pt-br "Alfaiate"
         @en "Tailor"
     }
     description {
         @pt-br "Um artesão especializado na confecção, reparo e alteração de roupas e vestimentas."
         @en "An artisan specialized in the making, repair, and alteration of clothes and garments."
     }
 }

phase PotionBrewer (instanceOf Profession) specializes Character {
     label {
         @pt-br "Mestre de Poções" // Or "Alquimista"
         @en "Potion Brewer" // Or "Alchemist"
     }
     description {
         @pt-br "Um especialista na arte de misturar ingredientes para criar poções com efeitos mágicos ou alquímicos."
         @en "A specialist in the art of mixing ingredients to create potions with magical or alchemical effects."
     }
 }

phase Merchant (instanceOf Profession) specializes Character {
     label {
         @pt-br "Mercador"
         @en "Merchant"
     }
     description {
         @pt-br "Um indivíduo envolvido na compra e venda de bens e serviços."
         @en "An individual involved in the buying and selling of goods and services."
     }
 }

phase Guard (instanceOf Profession) specializes Character {
     label {
         @pt-br "Guarda"
         @en "Guard"
     }
     description {
         @pt-br "Um indivíduo responsável por proteger pessoas, lugares ou propriedades."
         @en "An individual responsible for protecting people, places, or property."
     }
 }

phase Scholar (instanceOf Profession) specializes Character {
     label {
         @pt-br "Erudito"
         @en "Scholar"
     }
     description {
         @pt-br "Uma pessoa dedicada ao estudo e ao conhecimento em uma ou mais áreas."
         @en "A person dedicated to study and knowledge in one or more areas."
     }
 }

phase Farmer (instanceOf Profession) specializes Character {
     label {
         @pt-br "Fazendeiro"
         @en "Farmer"
     }
     description {
         @pt-br "Um indivíduo que cultiva a terra e cria animais para obter alimento e outros recursos."
         @en "An individual who cultivates land and raises animals to obtain food and other resources."
     }
 }

phase Miner (instanceOf Profession) specializes Character {
     label {
         @pt-br "Minerador"
         @en "Miner"
     }
     description {
         @pt-br "Um trabalhador que extrai minerais e outros materiais valiosos do subsolo."
         @en "A worker who extracts minerals and other valuable materials from underground."
     }
 }

phase Carpenter (instanceOf Profession) specializes Character {
     label {
         @pt-br "Carpinteiro"
         @en "Carpenter"
     }
     description {
         @pt-br "Um artesão que trabalha com madeira, construindo, reparando e instalando estruturas e objetos."
         @en "An artisan who works with wood, building, repairing, and installing structures and objects."
     }
 }


type Race {
    label {
        @pt-br "Raça"
        @en "Race"
    }
    description {
        @pt-br "Uma raça é uma característica geral de uma criatura, como sua aparência, comportamento, habilidades e características físicas. Ela é geralmente determinada por fatores como a natureza, a cultura e a linhagem."
        @en "A race is a general characteristic of a creature, such as its appearance, behavior, abilities, and physical traits. It is generally determined by factors like nature, culture, and lineage."
    }
}

disjoint genset TypesOfRaces {
    general Character
    categorizer Race
    specifics Elf, Orc, Human, HighElf, DarkElf, Gnome, Troll, Undead // Added missing specifics
}

subkind Elf (instanceOf Race) specializes Character {
    label {
        @pt-br "Elfo"
        @en "Elf"
    }
    description {
        @pt-br "Elfos são divindades maiores da natureza e da fertilidade. Os elfos são geralmente mostrados como jovens de grande beleza vivendo entre as florestas, sob a terra, em fontes e outros lugares naturais. São retratados como seres sensíveis, de longa vida ou imortalidade, com poderes mágicos e grande ligação com a natureza."
        @en "Elves are often depicted as major nature and fertility deities or spirits. They are generally shown as youthful beings of great beauty living among forests, under the earth, in springs, and other natural places. They are portrayed as sensitive beings, with long life or immortality, magical powers, and a strong connection to nature."
    }
}

subkind Orc (instanceOf Race) specializes Character {
    label {
        @pt-br "Orc"
        @en "Orc"
    }
    description {
        @pt-br "Orc, ork, orco ou orque (termo vindo do latim Orcus, um dos títulos de Plutão, o senhor do mundo dos mortos), aparece nas línguas germânicas e nos contos de fantasia medieval como uma criatura deformada e forte, que combate contra as forças do bem. Este conceito foi popularizado nos romances de Tolkien, O Hobbit e O Senhor dos Anéis, e virou recorrente em jogos de RPG de mesa ou RPG eletrônico, como D&D, World of Warcraft, Lineage II, Tibia, Grand Chase, The Lord of the Rings Online e Ragnarok Online, no entanto, não aparecem como criaturas maléficas na franquia The Elder Scrolls ou em World of Warcraft, sendo nesses jogos, uma raça semelhante aos homens."
        // Slightly condensed English version for better readability
        @en "Orc (from Latin Orcus) appears in Germanic languages and fantasy as a strong, often brutish creature, typically fighting against 'good'. Popularized by Tolkien, orcs are common in RPGs (D&D, WoW, etc.). Portrayals vary, sometimes non-evil (e.g., WoW, Elder Scrolls)."
    }
}

subkind Human (instanceOf Race) specializes Character {
    label {
        @pt-br "Humano"
        @en "Human"
    }
    description {
        @pt-br "Humanos são a raça mais comum em muitos mundos de fantasia. Eles são conhecidos por sua adaptabilidade, ambição e diversidade cultural. Geralmente possuem uma vida útil mais curta em comparação com outras raças como elfos e anões."
        @en "Humans are the most common race in many fantasy worlds. They are known for their adaptability, ambition, and cultural diversity. They generally have a shorter lifespan compared to other races like elves and dwarves."
    }
}

subkind HighElf (instanceOf Race) specializes Elf {
    label {
        @pt-br "Alto Elfo"
        @en "High Elf"
    }
    description {
        @pt-br "Altos Elfos são frequentemente retratados como mais inteligentes e mágicos do que outros elfos. Eles geralmente vivem em cidades élficas isoladas e possuem uma conexão profunda com a magia arcana e as artes."
        @en "High Elves are often portrayed as more intelligent and magical than other elves. They usually live in isolated elven cities and possess a deep connection with arcane magic and the arts."
    }
}

subkind DarkElf (instanceOf Race) specializes Elf {
    label {
        @pt-br "Elfo Negro" // Also Drow
        @en "Dark Elf" // Also Drow
    }
    description {
        @pt-br "Elfos Negros, também conhecidos como Drow em alguns cenários, são geralmente retratados como habitantes do subterrâneo com uma sociedade sombria e matriarcal. Eles são frequentemente associados à escuridão, venenos e magia negra."
        @en "Dark Elves, also known as Drow in some settings, are generally portrayed as inhabitants of the Underdark (or similar subterranean realms) with a dark and often matriarchal society. They are frequently associated with darkness, poisons, and dark magic."
    }
}

subkind Gnome (instanceOf Race) specializes Character {
    label {
        @pt-br "Gnomo"
        @en "Gnome"
    }
    description {
        @pt-br "Gnomos são criaturas pequenas e inteligentes, conhecidas por sua curiosidade, inventividade e habilidade em engenharia e tecnologia. Eles geralmente são amigáveis e excêntricos, com uma paixão por conhecimento e invenções."
        @en "Gnomes are small and intelligent creatures, known for their curiosity, inventiveness, and skill in engineering and technology. They are generally friendly and eccentric, with a passion for knowledge and inventions."
    }
}

subkind Troll (instanceOf Race) specializes Character {
    label {
        @pt-br "Troll"
        @en "Troll"
    }
    description {
        @pt-br "Trolls são criaturas grandes e fortes, frequentemente com pele verde ou acinzentada, presas proeminentes e, em algumas lendas, a capacidade de se regenerar rapidamente. Eles podem variar de tribos selvagens a seres mais civilizados, dependendo do universo de fantasia."
        @en "Trolls are large and strong creatures, often with green or grayish skin, prominent tusks, and, in some legends, the ability to regenerate rapidly. They can range from savage tribes to more civilized beings, depending on the fantasy universe."
    }
}

subkind Undead (instanceOf Race) specializes Character {
    label {
        @pt-br "Morto-vivo"
        @en "Undead"
    }
    description {
        @pt-br "Mortos-vivos são seres que já estiveram vivos, mas foram reanimados por meios mágicos ou sobrenaturais. Eles podem variar de esqueletos e zumbis a fantasmas e vampiros, e geralmente não possuem as mesmas necessidades ou emoções dos seres vivos."
        @en "Undead are beings that were once alive but have been reanimated by magical or supernatural means. They can range from skeletons and zombies to ghosts and vampires, and generally do not possess the same needs or emotions as living beings."
    }
}


mode Skill {
    label {
        @pt-br "Habilidade"
        @en "Skill"
    }
    description {
        @pt-br "Representa uma habilidade física ou mágica que um personagem pode utilizar em combate ou para outras ações."
        @en "Represents a physical or magical ability that a character can use in combat or for other actions."
    }
    level: number     // Nível da habilidade.
    _type: SkillType [1..*] // Tipo(s) elemental(is) ou de natureza da habilidade.
}

enum SkillType {
    label {
        @pt-br "Tipo de Habilidade"
        @en "Skill Type"
    }
    description {
        @pt-br "Representa o tipo elemental ou natureza de uma habilidade (fogo, sagrado, etc.)."
        @en "Represents the elemental type or nature of a skill (fire, sacred, etc.)."
    }
    // Enum Literals
    Sacred,     // Sagrado
    Fire,       // Fogo
    Ice,        // Gelo
    Poison,     // Veneno
    Evil,       // Maligno / Sombrio
    Forbidden,  // Proibido
    Protection  // Proteção / Defensivo
}

type Attribute {
    label {
        @pt-br "Atributo"
        @en "Attribute"
    }
    description {
        @pt-br "Representa um atributo fundamental de um personagem, como força, inteligência, agilidade, etc., que influencia suas capacidades."
        @en "Represents a fundamental attribute of a character, such as strength, intelligence, agility, etc., which influences their capabilities."
    }
}

quality Strength (instanceOf Attribute) {
    label {
        @pt-br "Força"
        @en "Strength"
    }
    description {
        @pt-br "Representa o poder físico bruto de um personagem, afetando dano corpo-a-corpo, capacidade de carga, etc."
        @en "Represents the raw physical power of a character, affecting melee damage, carrying capacity, etc."
    }
    qualityValue: number // O valor numérico do atributo Força.
}

quality Intelligence (instanceOf Attribute) {
    label {
        @pt-br "Inteligência"
        @en "Intelligence"
    }
    description {
        @pt-br "Representa a capacidade mental, raciocínio e conhecimento arcano de um personagem, afetando poder mágico, perícias baseadas em conhecimento, etc."
        @en "Represents the mental capacity, reasoning, and arcane knowledge of a character, affecting magical power, knowledge-based skills, etc."
    }
    qualityValue: number // O valor numérico do atributo Inteligência.
}

quality Agility (instanceOf Attribute) {
    label {
        @pt-br "Agilidade" // Ou Destreza
        @en "Agility" // Or Dexterity
    }
    description {
        @pt-br "Representa a coordenação física, reflexos e destreza manual de um personagem, afetando ataques à distância, esquiva, furtividade, etc."
        @en "Represents the physical coordination, reflexes, and manual dexterity of a character, affecting ranged attacks, evasion, stealth, etc."
    }
    qualityValue: number // O valor numérico do atributo Agilidade/Destreza.
}

quality Wisdom (instanceOf Attribute) {
    label {
        @pt-br "Sabedoria"
        @en "Wisdom"
    }
    description {
        @pt-br "Representa a percepção, intuição e força de vontade de um personagem, frequentemente afetando magia divina, percepção sensorial e resistências mentais."
        @en "Represents the perception, intuition, and willpower of a character, often affecting divine magic, sensory perception, and mental resistances."
    }
    qualityValue: number // O valor numérico do atributo Sabedoria.
}

quality Vitality (instanceOf Attribute) {
    label {
        @pt-br "Vitalidade" // Ou Constituição
        @en "Vitality" // Or Constitution
    }
    description {
        @pt-br "Representa a saúde física, resistência e durabilidade de um personagem, afetando pontos de vida, resistência a venenos/doenças, etc."
        @en "Represents the physical health, endurance, and hardiness of a character, affecting hit points, resistance to poison/disease, etc."
    }
    qualityValue: number // O valor numérico do atributo Vitalidade/Constituição.
}

quality Charisma (instanceOf Attribute) {
    label {
        @pt-br "Carisma"
        @en "Charisma"
    }
    description {
        @pt-br "Representa a força da personalidade, persuasão e capacidade de liderança de um personagem, afetando interações sociais, magia baseada em vontade (ex: Bardo/Feiticeiro), etc."
        @en "Represents the force of personality, persuasiveness, and leadership ability of a character, affecting social interactions, will-based magic (e.g., Bard/Sorcerer), etc."
    }
    qualityValue: number // O valor numérico do atributo Carisma.
}


// ---------------     Items     ---------------
kind Item {
    label {
        @pt-br "Item"
        @en "Item"
    }
    description {
        @pt-br "Um item é qualquer objeto que pode ser possuído, carregado ou armazenado por um personagem."
        @en "An item is any object that can be possessed, carried, or stored by a character."
    }
    name: string        // Nome do item.
    details: string     // Descrição detalhada ou 'flavor text' do item.
    weight: number      // Peso do item, afetando capacidade de carga.
}

type Equipment specializes Item { 
    label {
        @pt-br "Item equipável"
        @en "Equipment" 
    }
    description {
        @pt-br "Um item equipável é qualquer item projetado para ser vestido ou empunhado por um personagem para obter um benefício funcional ou estatístico."
        @en "An equippable item is any item designed to be worn or wielded by a character to gain a functional or statistical benefit."
    }
}

disjoint genset ItemsToEquip {
    general Item
    categorizer Equipment
    specifics Weapon, Armor, Accessory
}

type ConsumableItem specializes Item {
    label {
        @pt-br "Item consumível"
        @en "Consumable Item"
    }
    description {
        @pt-br "Um item consumível é qualquer item que é gasto ou destruído ao ser utilizado para produzir seu efeito."
        @en "A consumable item is any item that is spent or destroyed upon being used to produce its effect."
    }
}

disjoint genset ItemsToConsume {
    general Item
    categorizer ConsumableItem
    specifics Food, Scroll, Potion
}

disjoint complete genset TypesOfItems {
    general Item
    specifics Equipment, ConsumableItem
}


// ---------     Weapons     ---------
// InstanceOf Equipment used here implies Weapon is a ROLE played by Equipment, which might be complex.
// Simpler: 'subkind Weapon specializes Equipment' - Assuming this intent.
subkind Weapon (instanceOf Equipment) specializes Item {
    label {
        @pt-br "Arma"
        @en "Weapon"
    }
    description {
        @pt-br "Uma arma é um tipo de equipamento projetado primariamente para ser usado em combate para atacar, infligir dano ou aplicar efeitos prejudiciais a oponentes."
        @en "A weapon is a type of equipment primarily designed to be used in combat to attack, inflict damage, or apply detrimental effects to opponents."
    }
}

// InstanceOf Equipment implies OneHandWeapon is a role? Simpler: 'subkind OneHandWeapon specializes Weapon'
subkind OneHandWeapon specializes Weapon {
    label {
        @pt-br "Arma de uma mão"
        @en "One-Hand Weapon"
    }
    description {
        @pt-br "Uma arma de uma mão é qualquer arma projetada para ser empunhada e utilizada efetivamente com apenas uma mão."
        @en "A one-hand weapon is any weapon designed to be wielded and used effectively with only one hand."
    }
}
// InstanceOf Equipment implies TwoHandWeapon is a role? Simpler: 'subkind TwoHandWeapon specializes Weapon'
subkind TwoHandWeapon specializes Weapon {
    label {
        @pt-br "Arma de duas mãos"
        @en "Two-Hand Weapon"
    }
    description {
        @pt-br "Uma arma de duas mãos é qualquer arma que, devido ao seu tamanho, peso ou design, requer ambas as mãos para ser empunhada e utilizada efetivamente."
        @en "A two-hand weapon is any weapon that, due to its size, weight, or design, requires both hands to be wielded and used effectively."
    }
}

disjoint complete genset TypesOfWeapons {
    general Weapon
    specifics OneHandWeapon, TwoHandWeapon
}


subkind Knife specializes OneHandWeapon {
    label {
        @pt-br "Adaga"
        @en "Dagger" // Changed label to common RPG term
    }
    description {
        @pt-br "Uma adaga é uma arma branca curta, de lâmina geralmente pontiaguda e frequentemente de dois gumes, empunhada com uma mão. É valorizada pela sua rapidez, facilidade de ocultação e uso em ataques precisos ou furtivos."
        @en "A dagger is a short bladed weapon, with a generally pointed blade and often double-edged, wielded with one hand. It is valued for its speed, ease of concealment, and use in precise or stealthy attacks."
    }
}

subkind Sword specializes OneHandWeapon {
    label {
        @pt-br "Espada"
        @en "Sword"
    }
    description {
        @pt-br "Uma espada (de uma mão) é uma arma branca com uma lâmina longa, tipicamente reta e de um ou dois gumes, projetada para cortar e/ou estocar, empunhada com uma mão. É uma arma versátil comum em muitos cenários."
        @en "A (one-handed) sword is a bladed weapon with a long blade, typically straight and single or double-edged, designed for cutting and/or thrusting, wielded with one hand. It is a versatile weapon common in many settings."
    }
}

subkind Axe specializes OneHandWeapon {
    label {
        @pt-br "Machado"
        @en "Axe" // Or "Hand Axe"
    }
    description {
        @pt-br "Um machado (de uma mão) é uma arma consistindo de uma cabeça com lâmina afiada fixada a uma haste curta, empunhado com uma mão. É focado em causar dano por impacto e corte, sendo eficaz contra madeira ou armaduras."
        @en "A (one-handed) axe is a weapon consisting of a bladed head fixed to a short haft, wielded with one hand. It is focused on causing damage through impact and chopping, effective against wood or armor."
    }
}

disjoint complete genset TypesOfOneHandWeapon {
    general OneHandWeapon
    specifics Knife, Sword, Axe
}

subkind TwoKnifes specializes TwoHandWeapon {
    label {
        @pt-br "Adagas Duplas (Estilo)"
        @en "Dual Daggers (Style)"
    }
    description {
        @pt-br "Este termo ('Duas Adagas' ou 'Adagas Duplas') geralmente descreve o *estilo de combate* de empunhar uma adaga (Knife/Dagger) em cada mão, ou seja, usar duas 'Armas de Uma Mão' simultaneamente. Não representa um único item do tipo 'Arma de Duas Mãos'. (Ontologicamente, modelar isso como um subtipo de Arma de Duas Mãos é geralmente considerado incorreto; representa o uso de dois itens do tipo 'Adaga')."
        @en "This term ('Two Daggers' or 'Dual Daggers') generally describes the *fighting style* of wielding a dagger (Knife/Dagger) in each hand, i.e., using two 'One-Hand Weapons' simultaneously. It does not represent a single 'Two-Hand Weapon' type item. (Ontologically, modeling this as a subtype of Two-Hand Weapon is generally considered incorrect; it represents the use of two 'Dagger' type items)."
    }
}

subkind HeavySword specializes TwoHandWeapon {
    label {
        @pt-br "Espada Pesada"
        @en "Heavy Sword" // Alternatives: Two-Handed Sword, Greatsword
    }
    description {
        @pt-br "Uma espada pesada (ou espada de duas mãos / montante) é uma espada de grandes dimensões e peso, projetada para ser empunhada com ambas as mãos. Oferece maior alcance e um poder de impacto significativamente maior por golpe em comparação com espadas de uma mão, ao custo da velocidade e da impossibilidade de usar um escudo."
        @en "A heavy sword (or two-handed sword / greatsword) is a sword of large size and weight, designed to be wielded with both hands. It offers greater reach and significantly higher impact power per strike compared to one-handed swords, at the cost of speed and the inability to use a shield."
    }
}

subkind HeavyAxe specializes TwoHandWeapon {
    label {
        @pt-br "Machado Pesado"
        @en "Heavy Axe" // Alternatives: Two-Handed Axe, Greataxe
    }
    description {
        @pt-br "Um machado pesado (ou machado de duas mãos) possui uma cabeça de machado grande e/ou pesada em uma haste longa, exigindo o uso de ambas as mãos para controle e força máxima. É focado em desferir golpes devastadores com enorme poder de corte e impacto, excelente para romper defesas ou causar dano massivo."
        @en "A heavy axe (or two-handed axe / greataxe) has a large and/or heavy axe head on a long haft, requiring the use of both hands for control and maximum force. It is focused on delivering devastating blows with enormous chopping and impact power, excellent for breaking defenses or causing massive damage."
    }
}

disjoint complete genset TypesOfTwoHandWeapon {
    general TwoHandWeapon
    specifics TwoKnifes, HeavySword, HeavyAxe
}

// ---------     Armor     ---------
subkind Armor (instanceOf Equipment) specializes Item {
    label {
        @pt-br "Armadura"
        @en "Armor"
    }
    description {
        @pt-br "Armadura é um tipo de equipamento projetado para ser vestido ou equipado por um personagem a fim de fornecer proteção contra danos, aumentando sua defesa ou resistência." // Simplified PT
        @en "Armor is a type of equipment designed to be worn or equipped by a character in order to provide protection against damage, increasing their defense or resistance." // Simplified EN
    }
}

subkind Shield specializes Armor {
     label {
        @pt-br "Escudo"
        @en "Shield"
    }
    description {
        @pt-br "Um escudo é uma peça de armadura defensiva empunhada em uma mão (geralmente a mão inábil). Sua função primária é interceptar ataques, bloqueando golpes ou projéteis para proteger o portador, podendo ocasionalmente ser usado para golpear ('shield bash')."
        @en "A shield is a piece of defensive armor wielded in one hand (usually the off-hand). Its primary function is to intercept attacks, blocking strikes or projectiles to protect the wielder, and can occasionally be used for bashing ('shield bash')."
    }
}

subkind Helmet specializes Armor {
    label {
        @pt-br "Capacete"
        @en "Helmet"
    }
    description {
        @pt-br "Um capacete é uma peça de armadura projetada especificamente para proteger a cabeça do usuário contra impactos, cortes e outras formas de dano direcionadas àquela área."
        @en "A helmet is a piece of armor specifically designed to protect the user's head against impacts, cuts, and other forms of damage directed at that area."
    }
}

subkind Chestplate specializes Armor {
    label {
        @pt-br "Peitoral"
        @en "Chestplate" // Or Cuirass, Breastplate
    }
    description {
        @pt-br "Um peitoral é a peça de armadura que cobre e protege o torso (peito e costas) do usuário, uma área crítica que abriga órgãos vitais. Geralmente fornece a maior parte da proteção defensiva de um conjunto de armadura."
        @en "A chestplate is the piece of armor that covers and protects the user's torso (chest and back), a critical area housing vital organs. It generally provides the largest portion of defensive protection in an armor set."
    }
}

subkind Gloves specializes Armor {
    label {
        @pt-br "Luvas"
        @en "Gloves" // Or Gauntlets
    }
    description {
        @pt-br "Luvas são peças de armadura que cobrem e protegem as mãos e, dependendo do design, podem estender-se aos pulsos ou antebraços. Variam de tecido reforçado a metal articulado."
        @en "Gloves (or gauntlets) are pieces of armor that cover and protect the hands and, depending on the design, may extend to the wrists or forearms. They range from reinforced fabric to articulated metal."
    }
}

subkind Leggings specializes Armor {
    label {
        @pt-br "Perneiras"
        @en "Leggings" // Or Greaves, Legguards
    }
    description {
        @pt-br "Perneiras são peças de armadura projetadas para proteger as pernas do usuário (normalmente coxas e/ou canelas). São essenciais para a proteção das partes inferiores do corpo em combate."
        @en "Leggings (or greaves/legguards) are pieces of armor designed to protect the user's legs (usually thighs and/or shins). They are essential for protecting the lower body in combat."
    }
}

subkind Boots specializes Armor {
    label {
        @pt-br "Botas"
        @en "Boots"
    }
    description {
        @pt-br "Botas são peças de armadura que cobrem e protegem os pés e, frequentemente, os tornozelos ou a parte inferior das canelas. Além da defesa, podem afetar a movimentação ou oferecer outras propriedades."
        @en "Boots are pieces of armor that cover and protect the feet and often the ankles or lower shins. Besides defense, they can affect movement or offer other properties."
    }
}

// PartsOfArmor genset seems redundant if these are just subtypes, but translating anyway.
disjoint complete genset PartsOfArmor {
    general Armor
    specifics Helmet, Chestplate, Gloves, Leggings, Boots
}

// ---------     Accessories     ---------
subkind Accessory (instanceOf Equipment) specializes Item {
    label {
        @pt-br "Acessório"
        @en "Accessory"
     }
    description {
         @pt-br "Itens equipáveis que não são armas nem armaduras, geralmente fornecendo bônus ou habilidades, como jóias ou capas."
         @en "Equippable items that are not weapons or armor, generally providing bonuses or abilities, such as jewelry or capes."
    }
}

subkind Amulet specializes Accessory {
    label {
        @pt-br "Amuleto"
        @en "Amulet"
    }
    description {
        @pt-br "Um amuleto é um objeto, frequentemente um pingente, jóia ou pequeno item, ao qual se atribuem propriedades mágicas, protetoras ou de sorte. Em RPGs, costuma ser um item equipável (muitas vezes no slot de pescoço) que concede bônus ou habilidades." // Removed internal note
        @en "An amulet is an object, often a pendant, jewel, or small item, attributed with magical, protective, or lucky properties. In RPGs, it's usually an equippable item (often in the neck slot) that grants bonuses or abilities." // Removed internal note
    }
}

subkind Ring specializes Accessory {
    label {
        @pt-br "Anel"
        @en "Ring"
    }
    description {
        @pt-br "Um anel é uma peça de joalheria circular usada em um dedo. Em jogos de RPG, anéis são frequentemente itens mágicos que concedem bônus passivos, habilidades ativas ou resistências ao portador." // Removed internal note
        @en "A ring is a circular piece of jewelry worn on a finger. In RPGs, rings are often magical items that grant passive bonuses, active abilities, or resistances to the wearer." // Removed internal note
    }
}

subkind Necklace specializes Accessory {
    label {
        @pt-br "Colar"
        @en "Necklace"
    }
    description {
        @pt-br "Um colar é um adorno ou peça de joalheria usado ao redor do pescoço. Pode consistir de uma corrente, cordão, contas, gemas ou conter um pingente (que pode ser um Amuleto). Em RPGs, é um slot comum para itens mágicos equipáveis."
        @en "A necklace is an adornment or piece of jewelry worn around the neck. It can consist of a chain, cord, beads, gems, or contain a pendant (which might be an Amulet). In RPGs, it's a common slot for equippable magical "
    }
}

disjoint complete genset TypesOfAmulets {
    general Amulet 
    specifics Ring, Necklace
}

subkind Consumable specializes Item {
    label {
        @pt-br "Consumível"
        @en "Consumable"
    }
    description {
        @pt-br "Um item consumível é um tipo de item que é gasto, destruído ou perde seu efeito principal após uma ou um número limitado de utilizações. Exemplos comuns incluem poções, comidas, pergaminhos, reagentes alquímicos e munições."
        @en "A consumable item is a type of item that is spent, destroyed, or loses its main effect after one or a limited number of uses. Common examples include potions, food, scrolls, alchemical reagents, and ammunition."
    }
}

// ---------     Potion     ---------
subkind Potion specializes Consumable {
    label {
        @pt-br "Poção"
        @en "Potion"
    }
    description {
        @pt-br "Uma poção é um item consumível, geralmente um líquido mágico ou alquímico contido em um frasco, que concede um efeito benéfico (ou às vezes prejudicial) temporário ou instantâneo ao personagem que a utiliza (normalmente bebendo-a)."
        @en "A potion is a consumable item, usually a magical or alchemical liquid in a flask, which grants a beneficial (or sometimes harmful) temporary or instantaneous effect to the character who uses it (typically by drinking it)."
    }
}

subkind LifePotion specializes Potion {
    label {
        @pt-br "Poção de Vida"
        @en "Life Potion"
    }
    description {
        @pt-br "Uma poção de vida, ou poção de cura, é um tipo de poção cujo efeito primário é restaurar os pontos de vida (HP, saúde) perdidos pelo personagem, seja instantaneamente ou ao longo de um curto período."
        @en "A life potion, or healing potion, is a type of potion whose primary effect is to restore lost hit points (HP, health) to the character, either instantly or over a short period."
    }
}

subkind StaminaPotion specializes Potion {
    label {
        @pt-br "Poção de Vigor"
        @en "Stamina Potion"
    }
    description {
        @pt-br "Uma poção de vigor (ou estamina/energia) restaura o recurso utilizado para ações físicas intensas, como correr, esquivar, bloquear ou usar certas habilidades marciais, permitindo que o personagem continue a executá-las."
        @en "A stamina potion (or energy potion) restores the resource used for intense physical actions, such as running, dodging, blocking, or using certain martial abilities, allowing the character to continue performing them."
    }
}

subkind ManaPotion specializes Potion {
    label {
        @pt-br "Poção de Mana"
        @en "Mana Potion"
    }
    description {
        @pt-br "Uma poção de mana restaura o recurso energético utilizado para conjurar feitiços ou usar habilidades mágicas (mana, poder arcano, etc.), permitindo que conjuradores continuem a usar suas magias."
        @en "A mana potion restores the energy resource used for casting spells or using magical abilities (mana, arcane power, etc.), allowing spellcasters to continue using their magic."
    }
}

subkind SkillPotion specializes Potion {
    label {
        @pt-br "Poção de Habilidade/Atributo"
        @en "Skill/Attribute Potion"
    }
    description {
        @pt-br "Uma poção de habilidade ou atributo concede um bônus temporário a um ou mais atributos base (ex: Força, Inteligência) ou perícias específicas (ex: Furtividade, Alquimia) do personagem. Elixires frequentemente se encaixam nesta categoria."
        @en "A skill or attribute potion grants a temporary bonus to one or more base attributes (e.g., Strength, Intelligence) or specific skills (e.g., Stealth, Alchemy) of the character. Elixirs often fit into this category."
    }
}

disjoint complete genset TypesOfPotion {
    general Potion
    specifics LifePotion, StaminaPotion, ManaPotion, SkillPotion
}

// ---------     Others     ---------
subkind Food specializes Consumable {
    label {
        @pt-br "Comida"
        @en "Food"
    }
    description {
        @pt-br "Comida refere-se a itens consumíveis que podem ser ingeridos pelo personagem. Em RPGs, geralmente restauram uma pequena quantidade de vida ou vigor (muitas vezes ao longo do tempo) ou concedem bônus de status temporários ('buffs', como o estado 'bem alimentado')."
        @en "Food refers to consumable items that can be ingested by the character. In RPGs, they generally restore a small amount of health or stamina (often over time) or grant temporary status bonuses ('buffs', like the 'well-fed' state)."
    }
}

subkind Scroll specializes Consumable {
    label {
        @pt-br "Pergaminho"
        @en "Scroll"
    }
    description {
        @pt-br "Um pergaminho é um item consumível, tipicamente um rolo de papel ou material similar com inscrições (frequentemente mágicas). Permite ao usuário ativar um efeito específico (como conjurar um feitiço) uma única vez, após o qual o pergaminho é geralmente destruído ou se torna inerte."
        @en "A scroll is a consumable item, typically a roll of paper or similar material with inscriptions (often magical). It allows the user to activate a specific effect (such as casting a spell) a single time, after which the scroll is usually destroyed or becomes inert."
    }
}

// ---------------     Inventory     ---------------
kind Inventory {
    label {
        @pt-br "Inventário"
        @en "Inventory"
    }
    description {
        @pt-br "O inventário representa o espaço ou sistema onde um personagem armazena e gerencia seus itens."
        @en "The inventory represents the space or system where a character stores and manages their "
    }

    @memberOf [1] <>-- containsItems -- [0..*] Item // Represents items contained within the inventory
}

subkind Backpack specializes Inventory {
    label {
        @pt-br "Mochila"
        @en "Backpack"
    }
    description {
        @pt-br "A mochila é um tipo de inventário (contêiner) que o personagem carrega consigo, permitindo armazenar itens adicionais, geralmente com limites de espaço ou peso."
        @en "A backpack is a type of inventory (container) that the character carries, allowing them to store additional items, usually with space or weight limits."
    }
    slots: number     // Número de espaços/slots disponíveis na mochila.
    isFull: boolean   // Indica se a mochila está cheia (sem slots livres).
    isHeavy: boolean  // Indica se a mochila atingiu ou excedeu um limite de peso.
}


kind Magic {
    label {
        @pt-br "Magia"
        @en "Magic"
    }
    description {
        @pt-br "Magia representa o uso de forças ou energias sobrenaturais para produzir efeitos que transcendem as leis naturais percebidas. É a fonte de feitiços, encantamentos, rituais e outros fenômenos místicos, frequentemente categorizada em diferentes escolas, domínios ou fontes de poder."
        @en "Magic represents the use of supernatural forces or energies to produce effects that transcend perceived natural laws. It is the source of spells, enchantments, rituals, and other mystical phenomena, often categorized into different schools, domains, or sources of power."
    }
    // --- Attributes ---
    effectDescription: string     // Descrição textual do resultado ou consequência da magia.
    manaCost: number            // Custo de recurso (mana, energia, vida, etc.) para usar a magia.
    castingTime: string         // Tempo necessário para conjurar (ex: 'Instantâneo', '1 Ação', '1 Minuto').
    range: string               // Alcance máximo da magia (ex: 'Pessoal', 'Toque', '30 metros').
    duration: string            // Duração do efeito (ex: 'Instantâneo', 'Concentração, até 1 min', '1 hora').
    targetType: string          // Tipo de alvo afetado (ex: 'Pessoal', 'Criatura', 'Objeto', 'Área').
    requiresConcentration: boolean // Se requer concentração do conjurador para manter o efeito.
}


subkind DarkMagic specializes Magic {
    label {
        @pt-br "Magia Negra" // Ou Magia Sombria
        @en "Dark Magic" // Or Shadow Magic
    }
    description {
        @pt-br "Magia Negra (ou Sombria) é um tipo de magia frequentemente associada a forças proibidas, tabus ou malévolas. Envolve tipicamente necromancia (controle de mortos-vivos), maldições, manipulação de sombras ou energia negativa, drenagem de vida, e pactos com entidades obscuras. Seu uso pode ter consequências perigosas ou moralmente questionáveis."
        @en "Dark Magic (or Shadow Magic) is a type of magic often associated with forbidden, taboo, or malevolent forces. It typically involves necromancy (control of the undead), curses, manipulation of shadows or negative energy, life drain, and pacts with dark entities. Its use can have dangerous or morally questionable consequences."
    }
}

subkind SacredMagic specializes Magic {
    label {
        @pt-br "Magia Sagrada" // Ou Magia Divina
        @en "Sacred Magic" // Or Divine Magic
    }
    description {
        @pt-br "Magia Sagrada (ou Divina) deriva seu poder de divindades, fé fervorosa, ou energias cósmicas inerentemente boas ou ordenadas. É comumente usada para curar ferimentos, proteger aliados, abençoar, purificar, exorcizar ou destruir forças do mal (especialmente mortos-vivos e extraplanares malignos) e manipular luz ou energia sagrada."
        @en "Sacred Magic (or Divine Magic) derives its power from deities, fervent faith, or inherently good or ordered cosmic energies. It is commonly used to heal wounds, protect allies, bless, purify, exorcise or destroy evil forces (especially undead and evil outsiders), and manipulate holy light or energy."
    }
}

subkind ElementalMagic specializes Magic {
    label {
        @pt-br "Magia Elemental"
        @en "Elemental Magic"
    }
    description {
        @pt-br "Magia Elemental envolve a invocação, manipulação e controle direto das forças e substâncias fundamentais da natureza, como fogo, água, terra e ar. Permite criar ou controlar chamas, ondas, rochas, ventos, relâmpagos, gelo, etc., para diversos fins (ataque, defesa, utilidade)."
        @en "Elemental Magic involves the invocation, manipulation, and direct control of the fundamental forces and substances of nature, such as fire, water, earth, and air. It allows creating or controlling flames, waves, rocks, winds, lightning, ice, etc., for various purposes (attack, defense, utility)."
    }
}

subkind SpiritualMagic specializes Magic {
    label {
        @pt-br "Magia Espiritual" // Ou Magia Anímica
        @en "Spiritual Magic" // Or Spirit Magic
    }
    description {
        @pt-br "Magia Espiritual lida com a interação, invocação ou manipulação de espíritos (ancestrais, elementais, da natureza), almas, ou a própria energia vital (chi/ki). Pode envolver comunicação com o além, práticas xamânicas, projeção astral, fortalecimento da alma ou manipulação da força vital para cura ou combate."
        @en "Spiritual Magic deals with the interaction, summoning, or manipulation of spirits (ancestral, elemental, nature), souls, or life energy itself (chi/ki). It can involve communication with the beyond, shamanic practices, astral projection, soul strengthening, or manipulation of life force for healing or combat."
    }
}


datatype Coordinate {
    label {
        @pt-br "Coordenada Geográfica/Planar"
        @en "Geographical/Planar Coordinate"
    }
    description {
        @pt-br "Representa uma localização geográfica ou planar utilizando um par de valores numéricos."
        @en "Represents a geographic or planar location using a pair of numerical values."
    }
    // --- Attributes ---
    lat: number   // Coordenada de latitude (Norte-Sul) ou eixo Y.
    long: number  // Coordenada de longitude (Leste-Oeste) ou eixo X.
}

kind Place {
    label {
        @pt-br "Lugar"
        @en "Place"
    }
    description {
        @pt-br "Representa uma localização identificável no mundo do jogo, narrativa ou plano dimensional. Pode variar em escala desde uma pequena vila até um reino inteiro ou dimensão."
        @en "Represents an identifiable location in the game world, narrative, or dimensional plane. Can range in scale from a small village to an entire realm or dimension."
    }
    // --- Attributes ---
    name: string           // O nome próprio que identifica o lugar.
    position: Coordinate   // As coordenadas que especificam a localização do lugar.
}

subkind Realm specializes Place {
    label {
        @pt-br "Reino"
        @en "Realm"
    }
    description {
        @pt-br "Um reino representa um território extenso, frequentemente governado por um monarca (rei/rainha) ou outra autoridade central. Em cenários de fantasia, pode ter conotações mágicas ou abranger vastas áreas geográficas, possivelmente incluindo múltiplos países ou culturas."
        @en "A realm represents an extensive territory, often ruled by a monarch (king/queen) or other central authority. In fantasy settings, it may have magical connotations or encompass vast geographical areas, possibly including multiple countries or cultures."
    }
}

subkind Dimension specializes Place {
    label {
        @pt-br "Dimensão"
        @en "Dimension" // Or "Plane of Existence"
    }
    description {
        @pt-br "Uma dimensão (ou plano de existência) representa uma realidade separada ou um nível cosmológico distinto, potencialmente com leis físicas, habitantes e ambientes próprios. A 'posição' herdada pode ser interpretada metaforicamente, como um ponto de acesso, ou ser irrelevante dependendo do contexto dimensional."
        @en "A dimension (or plane of existence) represents a separate reality or a distinct cosmological level, potentially with its own physical laws, inhabitants, and environments. The inherited 'position' might be interpreted metaphorically, as an access point, or be irrelevant depending on the dimensional context."
    }
}

subkind Country specializes Place {
    label {
        @pt-br "País"
        @en "Country"
    }
    description {
        @pt-br "Um país é uma entidade política ou nação que ocupa um território geográfico definido, geralmente com um governo estabelecido, fronteiras reconhecidas (ou disputadas) e uma população com identidade cultural comum."
        @en "A country is a political entity or nation occupying a defined geographic territory, usually with an established government, recognized (or disputed) borders, and a population with a common cultural identity."
    }
}

subkind City specializes Place {
    label {
        @pt-br "Cidade"
        @en "City"
    }
    description {
        @pt-br "Uma cidade é um assentamento humano permanente, de grande porte e alta densidade populacional. Geralmente atua como um centro significativo de administração, comércio, cultura e interação social para uma região."
        @en "A city is a large, permanent, and densely populated human settlement. It generally acts as a significant center for administration, commerce, culture, and social interaction for a region."
    }
}

subkind Village specializes Place {
    label {
        @pt-br "Vila" // Ou Aldeia
        @en "Village" // Or Hamlet
    }
    description {
        @pt-br "Uma vila (ou aldeia) é um pequeno assentamento humano, tipicamente localizado em área rural e consideravelmente menor que uma cidade. Frequentemente baseada em agricultura, pesca ou extração de recursos locais."
        @en "A village (or hamlet) is a small human settlement, typically located in a rural area and considerably smaller than a city. Often based on agriculture, fishing, or extraction of local resources."
    }
}