:hasIntelligence rdf:type owl:ObjectProperty;
    rdfs:domain :Character;
    rdfs:range :Intelligence;
    rdfs:label "hasIntelligence"@en;
    rdfs:subPropertyOf gufo:inheresIn.
:hasAgility rdf:type owl:ObjectProperty;
    rdfs:domain :Character;
    rdfs:range :Agility;
    rdfs:label "hasAgility"@en;
