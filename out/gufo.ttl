    rdfs:label "Individual"@en.
:Language rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "Language"@en.
:Alignment rdf:type owl:Class, gufo:AbstractIndividualType, owl:NamedIndividual;
    rdfs:subClassOf gufo:QualityValue;
    owl:equivalentClass [
  rdf:type owl:Class;
  owl:oneOf (:LawfulGood :LawfulNeutral :LawfulEvil :NeutralGood :TrueNeutral :NeutralEvil :ChaoticGood :ChaoticNeutral :ChaoticEvil)
].
:LawfulGood rdf:type :Alignment;
    rdf:label "[object Object]".
:LawfulNeutral rdf:type :Alignment;
    rdf:label "[object Object]".
:LawfulEvil rdf:type :Alignment;
