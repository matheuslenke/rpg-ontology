    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "requiresConcentration"@en.
:level rdfs:domain :Skill;
    rdfs:range :number;
    rdf:type owl:DatatypeProperty;
