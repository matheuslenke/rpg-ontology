    rdfs:range :Vitality;
    rdfs:label "hasVitality"@en;
    rdfs:subPropertyOf gufo:inheresIn.
:hasCharisma rdf:type owl:ObjectProperty;
    rdfs:domain :Character;
    rdfs:range :Charisma;
    rdfs:label "hasCharisma"@en;
    rdfs:subPropertyOf gufo:inheresIn.
:hasWisdom rdf:type owl:ObjectProperty;
    rdfs:domain :Character;
    rdfs:range :Wisdom;
    rdfs:label "hasWisdom"@en;
    rdfs:subPropertyOf gufo:inheresIn.
:Individual rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty :isBornIn;
  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :Place
].
