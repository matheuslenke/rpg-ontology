@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<https://example.com> rdf:type owl:Ontology;
    owl:imports gufo:.
:Coordinate rdf:type owl:Class, gufo:AbstractIndividualType, owl:NamedIndividual;
    rdfs:subClassOf gufo:QualityValue;
    rdfs:label "Coordinate"@en.
:Place rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "Place"@en.
:Realm rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "Realm"@en.
:Dimension rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "Dimension"@en.
:Country rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "Country"@en.
:City rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "City"@en.
:Village rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "Village"@en.
:Magic rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:FunctionalComplex;
    rdfs:label "Magic"@en.
:DarkMagic rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "DarkMagic"@en.
:SacredMagic rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "SacredMagic"@en.
:ElementalMagic rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "ElementalMagic"@en.
:SpiritualMagic rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "SpiritualMagic"@en.
:Skill rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:IntrinsicMode;
    rdfs:label "Skill"@en.
:SkillType rdf:type owl:Class, gufo:AbstractIndividualType, owl:NamedIndividual;
    rdfs:subClassOf gufo:QualityValue;
    owl:equivalentClass [
  rdf:type owl:Class;
  owl:oneOf (:Sacred :Fire :Ice :Poison :Evil :Forbidden :Protection)
].
:Sacred rdf:type :SkillType;
    rdf:label "[object Object]".
:Fire rdf:type :SkillType;
    rdf:label "[object Object]".
:Ice rdf:type :SkillType;
    rdf:label "[object Object]".
:Poison rdf:type :SkillType;
    rdf:label "[object Object]".
:Evil rdf:type :SkillType;
    rdf:label "[object Object]".
:Forbidden rdf:type :SkillType;
    rdf:label "[object Object]".
:Protection rdf:type :SkillType;
    rdf:label "[object Object]".
:SkillType rdfs:label "SkillType"@en.
:Attribute rdf:type owl:NamedIndividual;
    rdfs:subClassOf gufo:ConcreteIndividualType;
    rdfs:label "Attribute"@en.
:Strength rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:Quality;
    rdfs:label "Strength"@en.
:Intelligence rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:Quality;
    rdfs:label "Intelligence"@en.
:Agility rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
