    rdfs:label "Undead"@en.
:ProfessionSkillLevel rdf:type owl:Class, gufo:AbstractIndividualType, owl:NamedIndividual;
    rdfs:subClassOf gufo:QualityValue;
    owl:equivalentClass [
  rdf:type owl:Class;
  owl:oneOf (:Dummy :Beginner :Intermediate :Advanced)
].
:Dummy rdf:type :ProfessionSkillLevel;
    rdf:label "[object Object]".
:Beginner rdf:type :ProfessionSkillLevel;
    rdf:label "[object Object]".
:Intermediate rdf:type :ProfessionSkillLevel;
    rdf:label "[object Object]".
:Advanced rdf:type :ProfessionSkillLevel;
    rdf:label "[object Object]".
:ProfessionSkillLevel rdfs:label "ProfessionSkillLevel"@en.
