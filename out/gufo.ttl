[ rdf:type owl:AllDisjointClasses ] owl:members (:Elf :Orc :Human :HighElf :DarkElf :Gnome :Troll :Undead).
[ rdf:type owl:AllDisjointClasses ] owl:members (:Warrior :Mage :Rogue :Cleric :Ranger :Paladin :Druid :Barbarian :Bard :Monk :Sorcerer :Warlock :Shaman).
:lat rdfs:domain :Coordinate;
    rdfs:range :number;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasValueComponent;
    rdfs:label "lat"@en.
:long rdfs:domain :Coordinate;
    rdfs:range :number;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasValueComponent;
    rdfs:label "long"@en.
:name rdfs:domain :Place;
    rdfs:range xsd:string;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "name"@en.
:position rdfs:domain :Place;
    rdfs:range :Coordinate;
    rdf:type owl:ObjectProperty;
    rdfs:subPropertyOf gufo:hasReifiedQualityValue;
    rdfs:label "position"@en.
:effectDescription rdfs:domain :Magic;
    rdfs:range xsd:string;
    rdf:type owl:DatatypeProperty;
