    rdfs:subClassOf gufo:ConcreteIndividualType;
    rdfs:label "Profession"@en.
:Blacksmith rdf:type owl:Class, gufo:Phase, owl:NamedIndividual;
    rdfs:label "Blacksmith"@en.
:Herbalist rdf:type owl:Class, gufo:Phase, owl:NamedIndividual;
