    rdfs:label "Vitality"@en.
:Charisma rdf:type owl:Class, gufo:Kind, owl:NamedIndividual;
    rdfs:subClassOf gufo:Quality;
    rdfs:label "Charisma"@en.
:Race rdf:type owl:NamedIndividual;
    rdfs:subClassOf gufo:ConcreteIndividualType;
    rdfs:label "Race"@en.
:Elf rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "Elf"@en.
:Orc rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "Orc"@en.
:Human rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "Human"@en.
:HighElf rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "HighElf"@en.
:DarkElf rdf:type owl:Class, gufo:SubKind, owl:NamedIndividual;
    rdfs:label "DarkElf"@en.
